# Copy to .env for local development. In production (cPanel) set these in "Setup Node.js App".

# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://ncg:ncg_password@localhost:3306/ncg_pharmacy

# Port for the Express server (Passenger sets this automatically on cPanel)
PORT=3001

# development | production | test
NODE_ENV=development

# Folder for uploaded product images (must persist outside the build output in production)
UPLOAD_DIR=./server/uploads

# Optional: database used by the API/DB test suite. It is WIPED on every test run,
# so its name must end in "_test". DB tests are skipped when this is unset.
TEST_DATABASE_URL=mysql://ncg:ncg_password@localhost:3306/ncg_pharmacy_test
